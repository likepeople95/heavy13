{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)\\.(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "api/room.js": { "maxDuration": 10 }
  }
}
